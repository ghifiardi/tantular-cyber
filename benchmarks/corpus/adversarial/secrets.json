{
  "suite": "secrets",
  "suite_version": "1.1.0",
  "description": "security.redact must remove each 'secret' substring (expect=redacted) or leave the text unchanged (expect=kept). All values are synthetic or documented examples.",
  "items": [
    {
      "id": "sec-001",
      "text": "-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAexampleKEYbody0000\nexampleSecondLine1111\n-----END RSA PRIVATE KEY-----",
      "secret": "MIIEowIBAAKCAQEAexampleKEYbody0000",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "multiline private key"
    },
    {
      "id": "sec-002",
      "text": "DB_PASSWORD = \"\"\"\ncorpus-multiline-secret-1\n\"\"\"",
      "secret": "corpus-multiline-secret-1",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "triple-quoted multiline"
    },
    {
      "id": "sec-003",
      "text": "password: str = \"annotated-secret-22\"",
      "secret": "annotated-secret-22",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "type-annotated assignment"
    },
    {
      "id": "sec-004",
      "text": "POSTGRES_PASSWORD: yaml-secret-55x",
      "secret": "yaml-secret-55x",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "unquoted YAML value with digits"
    },
    {
      "id": "sec-005",
      "text": "aws_key = 'AKIAIOSFODNN7EXAMPLE'",
      "secret": "AKIAIOSFODNN7EXAMPLE",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "AWS documentation example key"
    },
    {
      "id": "sec-006",
      "text": "Authorization: Basic YWRtaW46ZXhhbXBsZVBhc3MxMjM=",
      "secret": "YWRtaW46ZXhhbXBsZVBhc3MxMjM=",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "HTTP Basic (base64 admin:examplePass123)"
    },
    {
      "id": "sec-007",
      "text": "blob = \"QUtJQUlPU0ZPRE5ON0VYQU1QTEU=\"",
      "secret": "QUtJQUlPU0ZPRE5ON0VYQU1QTEU=",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "base64 of a known key format"
    },
    {
      "id": "sec-008",
      "text": "# admin password is CorpusPass99",
      "secret": "CorpusPass99",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "credential in comment (EN)"
    },
    {
      "id": "sec-009",
      "text": "# kata sandi admin: rahasiaContoh77",
      "secret": "rahasiaContoh77",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "credential in comment (ID)"
    },
    {
      "id": "sec-010",
      "text": "url = 'https://bob:example%40pw1@db.example.com/x'",
      "secret": "example%40pw1",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "credentials in URL"
    },
    {
      "id": "sec-011",
      "text": "api_key: abcdefghijkl",
      "secret": "abcdefghijkl",
      "expect": "redacted",
      "known_blind_spot": true,
      "note": "plain-letter unquoted value (no digit/symbol)"
    },
    {
      "id": "sec-012",
      "text": "cfg_value = \"hunter2hunter2\"",
      "secret": "hunter2hunter2",
      "expect": "redacted",
      "known_blind_spot": true,
      "note": "secret in an innocuously named variable"
    },
    {
      "id": "sec-013",
      "text": "blob = \"414b4941494f53464f444e4e374558414d504c45\"",
      "secret": "414b4941494f53464f444e4e374558414d504c45",
      "expect": "redacted",
      "known_blind_spot": true,
      "note": "hex-encoded key"
    },
    {
      "id": "sec-014",
      "text": "secret_val = rot13(\"rknzcyr-frperg\")",
      "secret": "rknzcyr-frperg",
      "expect": "redacted",
      "known_blind_spot": true,
      "note": "custom encoding inside a call"
    },
    {
      "id": "sec-015",
      "text": "password = get_password(user)",
      "secret": "password = get_password(user)",
      "expect": "kept",
      "known_blind_spot": false,
      "note": "ordinary code must not be altered"
    },
    {
      "id": "sec-016",
      "text": "if password is None:",
      "secret": "if password is None:",
      "expect": "kept",
      "known_blind_spot": false,
      "note": "ordinary code must not be altered"
    },
    {
      "id": "sec-017",
      "text": "token = request.headers['X-Token']",
      "secret": "token = request.headers['X-Token']",
      "expect": "kept",
      "known_blind_spot": false,
      "note": "ordinary code must not be altered"
    },
    {
      "id": "sec-018",
      "text": "secret_key = settings.SECRET_KEY",
      "secret": "secret_key = settings.SECRET_KEY",
      "expect": "kept",
      "known_blind_spot": false,
      "note": "ordinary code must not be altered"
    },
    {
      "id": "sec-019",
      "text": "query = \"SELECT id FROM users WHERE username = '\" + username + \"'\"",
      "secret": "query = \"SELECT id FROM users WHERE username = '\" + username + \"'\"",
      "expect": "kept",
      "known_blind_spot": false,
      "note": "ordinary code must not be altered"
    },
    {
      "id": "sec-020",
      "text": "# compute the password hash with bcrypt",
      "secret": "# compute the password hash with bcrypt",
      "expect": "kept",
      "known_blind_spot": false,
      "note": "ordinary code must not be altered"
    },
    {
      "id": "sec-021",
      "text": "sha = \"3f786850e387550fdab836ed7e6dc881de23001b\"",
      "secret": "sha = \"3f786850e387550fdab836ed7e6dc881de23001b\"",
      "expect": "kept",
      "known_blind_spot": false,
      "note": "ordinary code must not be altered"
    },
    {
      "id": "sec-022",
      "text": "pass\u200bword = \"unicode-secret-001\"",
      "secret": "unicode-secret-001",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "zero-width character inside the credential name"
    },
    {
      "id": "sec-023",
      "text": "password = \"\u202eunicode-secret-002\u202c\"",
      "secret": "unicode-secret-002",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "bidi override around the value"
    },
    {
      "id": "sec-024",
      "text": "p\u0430ssword = \"unicode-secret-003\"",
      "secret": "unicode-secret-003",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "Cyrillic homoglyph in the identifier"
    },
    {
      "id": "sec-025",
      "text": "# admin pass\u200bword is UnicodeSecret004",
      "secret": "UnicodeSecret004",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "zero-width character in a comment credential"
    },
    {
      "id": "sec-026",
      "text": "{\"p\u0430ss\u200bword\": \"unicode-secret-005\"}",
      "secret": "unicode-secret-005",
      "expect": "redacted",
      "known_blind_spot": false,
      "note": "homoglyph + zero-width in a JSON key"
    },
    {
      "id": "sec-027",
      "text": "p\u0430rser = make_parser()",
      "secret": "p\u0430rser = make_parser()",
      "expect": "kept",
      "known_blind_spot": false,
      "note": "homoglyph identifier that is not a credential must not change"
    }
  ]
}
