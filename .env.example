# Example configuration for tantular-cyber. Contains no secrets; copy values into your
# shell (e.g. `set -a; source .env.example; set +a`). CLI flags override these.

# Local Ollama endpoint (localhost only unless TANTULAR_ALLOW_REMOTE_OLLAMA=1)
TANTULAR_OLLAMA_URL=http://127.0.0.1:11434
TANTULAR_MODEL=tantular-cyber:latest
# Seconds per /api/chat request (first call includes model load time)
TANTULAR_OLLAMA_TIMEOUT=300
TANTULAR_OLLAMA_RETRIES=2
# Set to 1 ONLY if you deliberately want to send code excerpts to a non-local endpoint
TANTULAR_ALLOW_REMOTE_OLLAMA=0

# Semgrep executable (brew install semgrep, or pip install 'tantular-cyber[semgrep]')
TANTULAR_SEMGREP_BIN=semgrep

# Opt-in live smoke test: TANTULAR_RUN_OLLAMA_SMOKE=1 pytest -m ollama
TANTULAR_RUN_OLLAMA_SMOKE=0
